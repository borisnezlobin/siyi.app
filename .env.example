NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Siyi.app
NEXT_PUBLIC_APP_SHORT_NAME=Siyi
NEXT_PUBLIC_APP_SLUG=siyi-app
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
# Who can reach /admin. Leave both empty and nobody can.
# Prefer ADMIN_USER_IDS: signup is open, so an email allowlist only holds while
# Supabase is confirming addresses. When ADMIN_USER_IDS is set it decides on its
# own and ADMIN_EMAILS is ignored. Find the ids under Authentication > Users.
# Both are comma-separated.
ADMIN_USER_IDS=
ADMIN_EMAILS=
CRON_SECRET=
UNSUBSCRIBE_SECRET=
RESEND_API_KEY=
# Sender for the email the app itself sends, on a domain verified in Resend.
MARKETING_FROM_EMAIL=Siyi <hello@siyi.app>
EXPO_ACCESS_TOKEN=
# Base URL of the Amelia conversation-capture service (server-side only).
# Leave empty and the Amelia section never renders. Amelia's default port is
# 3000, the same as Next dev — run it on another port locally.
AMELIA_API_URL=
# Optional shared secret sent to Amelia as a bearer token.
AMELIA_API_KEY=
APPLE_CLIENT_ID=app.siyi.mobile
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
